#!/bin/sh
grep -q " /proc " /proc/mounts 2>/dev/null || mount -t proc none /proc
grep -q " /sys " /proc/mounts || mount -t sysfs none /sys
mount -t tmpfs none /tmp
mount -t devtmpfs none /dev
hostname embedded-lab2
if grep -q bai11_20_test=1 /proc/cmdline; then
    /usr/bin/test_lab2.sh
    result=$?
    echo "BAI11_20_TEST_RESULT=$result"
    sync
    reboot -f
fi
if insmod /lib/modules/$(uname -r)/lab2_driver.ko; then
    [ -c /dev/lab2 ] || mknod /dev/lab2 c 240 0
    chmod 666 /dev/lab2
    echo 'LAB02 ready: /dev/lab2, /proc/lab2_info, /sys/class/lab2_class/lab2'
    echo 'Bai 11-20: /usr/bin/test_lab2.sh (resets data and statistics)'
else
    echo 'ERROR: could not load lab2_driver'
fi
